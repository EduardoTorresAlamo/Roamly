# ─── Server-side only (NEVER prefix these with VITE_) ────────────────────────
# Vite inlines every VITE_* variable into the client bundle in plain text, so a
# VITE_-prefixed secret is public. Set this one in the hosting provider's env
# (Vercel/Netlify project settings) — it is read only by api/unsplash.ts.
UNSPLASH_ACCESS_KEY=

# ─── Client-side (public — these ship inside the bundle) ─────────────────────
# URL of the server-side Unsplash proxy. Leave empty to disable live photo search
# and use only the curated destination images.
VITE_UNSPLASH_PROXY_URL=/api/unsplash

# ─── Server-side only ────────────────────────────────────────────────────────
# Extra origins allowed to call /api/unsplash, comma-separated absolute URLs.
# The deployment's own origin is always allowed, so this is only needed when the
# frontend is served from a different domain than the proxy (custom domain,
# preview alias, separate staging host).
# ALLOWED_ORIGINS=https://roamly.app,https://www.roamly.app
